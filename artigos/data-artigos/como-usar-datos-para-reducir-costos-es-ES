La estructura de datos debe ser flexible para recibir datos brutos y optimizada para el análisis. La arquitectura Bronce-Plata-Oro es el estándar moderno:



1.1 Data Quality: El Corazón de la Confiabilidad

Implementar verificaciones de calidad es crucial antes de cualquier análisis para evitar el "SÍndrome de Basura Entra, Basura Sale" (Garbage In, Garbage Out).

```

import pandas as pd

from typing import Dict, List

class DataQualityChecker:

"""Validaciones esenciales de calidad de datos en la capa Silver"""

def init(self):

self.errors = []

def validate_dataset(self, df: pd.DataFrame, rules: Dict) -> bool:

self.errors = []

# 1. Campos obligatorios (Schema Check)

if 'required_columns' in rules:

missing = set(rules['required_columns']) - set(df.columns)

if missing:

self.errors.append(f"Columnas faltantes: {missing}")

# 2. Rango de valores (Outlier Check)

if 'value_ranges' in rules:

for col, (min_val, max_val) in rules['value_ranges'].items():

outliers = df[(df[col] < min_val) | (df[col] > max_val)]

if len(outliers) > 0:

self.errors.append(

f"{col}: {len(outliers)} valores fuera del rango [{min_val}, {max_val}]"

)

# 3. Valores nulos (Integrity Check)

if 'no_nulls' in rules:

for col in rules['no_nulls']:

null_count = df[col].isnull().sum()

if null_count > 0:

self.errors.append(f"{col}: {null_count} valores nulos")

return len(self.errors) == 0

```


